# Site de Luka dans le proxy commun du serveur (/srv/edge).
# deploy.sh y met le domaine et le dépose dans /srv/edge/sites/luka.caddy.

__DOMAIN__ {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy luka-web:3000 {
		# Les pages arrivent en flux (Suspense) : rien n'est retenu par le proxy.
		flush_interval -1
		# Pendant le remplacement du conteneur web, Caddy patiente au lieu de renvoyer une erreur.
		lb_try_duration 30s
	}
}
