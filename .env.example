# --- Base de données (local : docker compose up -d ; production : URL Supabase "Session pooler") ---
DATABASE_URL=postgres://luka:luka@localhost:5544/luka

# --- Authentification (Better Auth) ---
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=change-moi
BETTER_AUTH_URL=http://localhost:3000
# Connexion Google (facultatif)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Captcha Cloudflare Turnstile (facultatif, recommandé en production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- IA gratuite : toute API compatible OpenAI (Groq, OpenRouter, Cerebras, Ollama…) ---
# Groq     : https://api.groq.com/openai/v1        modèle ex. openai/gpt-oss-120b (liste : GET /models)
# OpenRouter : https://openrouter.ai/api/v1         modèle ex. meta-llama/llama-3.3-70b-instruct:free
# Ollama   : http://localhost:11434/v1             modèle ex. qwen2.5:7b (clé : ollama)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# --- Recherche web (https://tavily.com, quota gratuit mensuel) ---
# Sans clé, Luka utilise seulement les connaissances du modèle (résultats marqués « à vérifier »).
TAVILY_API_KEY=

# --- Limites de l'offre gratuite ---
FREE_COLLECTES_PER_DAY=5
FREE_MAX_ROWS=200
FREE_MAX_QUERIES=3
# Plafond global d'appels IA par jour (tous utilisateurs) pour protéger ton quota
GLOBAL_LLM_CALLS_PER_DAY=500

# --- Page d'accueil ---
# Vidéo de démonstration (ex. /landing/demo.mp4 placé dans public/, ou une URL). Vide = emplacement « bientôt disponible ».
DEMO_VIDEO_URL=
# Adresse de contact affichée dans les conditions d'utilisation et la politique de confidentialité
CONTACT_EMAIL=

# --- Sources ouvertes (facultatif) ---
# Serveurs Overpass (OpenStreetMap), séparés par des virgules. Par défaut : serveurs publics.
OVERPASS_URL=
NOMINATIM_URL=
# Sites web d'établissements lus par collecte pour trouver emails, téléphones et réseaux sociaux
FREE_MAX_ENRICH_SITES=25
# Collectes exécutées en parallèle par le serveur (les autres attendent dans la file)
WORKER_CONCURRENCY=2
# LUKA_WORKER=off désactive la file sur ce serveur (ex. un second serveur web sans travailleur)

# --- Premium : Apify (Google Maps, Instagram, Facebook) ---
# Jeton : https://console.apify.com/settings/integrations
APIFY_TOKEN=
# Dépense maximale par collecte Premium, en dollars
APIFY_MAX_USD_PER_COLLECTE=5
PREMIUM_MAX_ROWS=10000
PREMIUM_COLLECTES_PER_DAY=30

# --- E-mails (activation des comptes) : tout fournisseur SMTP (Brevo, Resend, Mailjet…) ---
# Sans SMTP_HOST : en développement, le lien d'activation s'affiche dans la console du serveur ;
# en production, l'activation par e-mail est désactivée.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Luka <no-reply@luka.berenismassamba.com>"

# Signalement des erreurs du serveur (Sentry, facultatif). Sans SENTRY_DSN, rien n'est envoyé.
SENTRY_DSN=
